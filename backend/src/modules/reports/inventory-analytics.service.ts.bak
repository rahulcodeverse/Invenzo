import { Injectable } from '@nestjs/common';
import { PrismaService } from '../../prisma/prisma.service';

@Injectable()
export class InventoryAnalyticsService {
  constructor(private prisma: PrismaService) {}

  async getStockAgeing(tenantId: string) {
    const stocks = await this.prisma.stock.findMany({
      where: {
        product: { tenantId },
        quantity: { gt: 0 },
      },
      include: {
        product: {
          select: {
            id: true,
            name: true,
            sku: true,
            unitPrice: true,
          },
        },
        warehouse: {
          select: {
            name: true,
          },
        },
        batches: {
          where: { quantity: { gt: 0 } },
          orderBy: { createdAt: 'asc' },
        },
      },
    });

    const now = new Date();
    const ageing = stocks.map(stock => {
      const oldestBatch = stock.batches[0];
      const daysInStock = oldestBatch
        ? Math.floor(
            (now.getTime() - oldestBatch.createdAt.getTime()) / (1000 * 60 * 60 * 24),
          )
        : 0;

      let ageCategory: string;
      if (daysInStock <= 30) ageCategory = '0-30 days';
      else if (daysInStock <= 60) ageCategory = '31-60 days';
      else if (daysInStock <= 90) ageCategory = '61-90 days';
      else ageCategory = '90+ days';

      return {
        product: stock.product,
        warehouse: stock.warehouse.name,
        quantity: stock.quantity,
        daysInStock,
        ageCategory,
        value: stock.quantity * Number(stock.product.unitPrice || 0),
      };
    });

    // Group by age category
    const grouped = ageing.reduce(
      (acc, item) => {
        if (!acc[item.ageCategory]) {
          acc[item.ageCategory] = { items: 0, quantity: 0, value: 0 };
        }
        acc[item.ageCategory].items += 1;
        acc[item.ageCategory].quantity += item.quantity;
        acc[item.ageCategory].value += item.value;
        return acc;
      },
      {} as Record<string, { items: number; quantity: number; value: number }>,
    );

    return {
      summary: grouped,
      details: ageing.sort((a, b) => b.daysInStock - a.daysInStock),
    };
  }

  async getDeadStock(tenantId: string, daysSinceLastMovement: number = 90) {
    const cutoffDate = new Date();
    cutoffDate.setDate(cutoffDate.getDate() - daysSinceLastMovement);

    // Get products with stock but no recent movements
    const stocks = await this.prisma.stock.findMany({
      where: {
        product: { tenantId },
        quantity: { gt: 0 },
      },
      include: {
        product: {
          select: {
            id: true,
            name: true,
            sku: true,
            unitPrice: true,
            category: {
              select: { name: true },
            },
          },
        },
        warehouse: {
          select: { name: true },
        },
      },
    });

    const deadStockItems = await Promise.all(
      stocks.map(async stock => {
        // Check last movement
        const lastMovement = await this.prisma.stockMovement.findFirst({
          where: {
            productId: stock.productId,
            warehouseId: stock.warehouseId,
          },
          orderBy: { createdAt: 'desc' },
        });

        const daysSinceMovement = lastMovement
          ? Math.floor(
              (new Date().getTime() - lastMovement.createdAt.getTime()) /
                (1000 * 60 * 60 * 24),
            )
          : 999;

        if (daysSinceMovement >= daysSinceLastMovement) {
          return {
            product: stock.product,
            warehouse: stock.warehouse.name,
            quantity: stock.quantity,
            value: stock.quantity * Number(stock.product.unitPrice || 0),
            daysSinceLastMovement,
            lastMovementDate: lastMovement?.createdAt,
          };
        }
        return null;
      }),
    );

    const filtered = deadStockItems.filter(item => item !== null);

    const totalValue = filtered.reduce((sum, item) => sum + item!.value, 0);

    return {
      itemCount: filtered.length,
      totalValue,
      items: filtered.sort((a, b) => b!.value - a!.value),
    };
  }

  async getReorderSuggestions(tenantId: string) {
    const products = await this.prisma.product.findMany({
      where: {
        tenantId,
        isActive: true,
      },
      select: {
        id: true,
        name: true,
        sku: true,
        minStock: true,
        maxStock: true,
        reorderPoint: true,
        unitPrice: true,
        stocks: {
          select: {
            available: true,
            warehouse: {
              select: {
                name: true,
              },
            },
          },
        },
      },
    });

    const reorderNeeded = products
      .map(product => {
        const totalAvailable = product.stocks.reduce((sum, s) => sum + s.available, 0);
        const reorderPoint = product.reorderPoint || product.minStock || 0;
        const maxStock = product.maxStock || reorderPoint * 3;
        const suggestedOrderQty = Math.max(0, maxStock - totalAvailable);

        if (totalAvailable <= reorderPoint && suggestedOrderQty > 0) {
          return {
            product: {
              id: product.id,
              name: product.name,
              sku: product.sku,
            },
            currentStock: totalAvailable,
            reorderPoint,
            maxStock,
            suggestedOrderQty,
            estimatedCost: suggestedOrderQty * Number(product.unitPrice || 0),
            warehouses: product.stocks.map(s => ({
              warehouse: s.warehouse.name,
              available: s.available,
            })),
          };
        }
        return null;
      })
      .filter(item => item !== null);

    const totalEstimatedCost = reorderNeeded.reduce(
      (sum, item) => sum + item!.estimatedCost,
      0,
    );

    return {
      itemCount: reorderNeeded.length,
      totalEstimatedCost,
      items: reorderNeeded.sort((a, b) => b!.estimatedCost - a!.estimatedCost),
    };
  }

  async getBatchExpiryReport(tenantId: string, daysUntilExpiry: number = 30) {
    const futureDate = new Date();
    futureDate.setDate(futureDate.getDate() + daysUntilExpiry);

    const expiringBatches = await this.prisma.batch.findMany({
      where: {
        stock: {
          product: { tenantId },
        },
        expiryDate: {
          lte: futureDate,
          gte: new Date(),
        },
        quantity: { gt: 0 },
      },
      include: {
        stock: {
          include: {
            product: {
              select: {
                id: true,
                name: true,
                sku: true,
                unitPrice: true,
              },
            },
            warehouse: {
              select: {
                name: true,
              },
            },
          },
        },
      },
      orderBy: {
        expiryDate: 'asc',
      },
    });

    const batches = expiringBatches.map(batch => {
      const daysUntilExp = Math.floor(
        (batch.expiryDate.getTime() - new Date().getTime()) / (1000 * 60 * 60 * 24),
      );

      let urgency: string;
      if (daysUntilExp <= 7) urgency = 'Critical';
      else if (daysUntilExp <= 15) urgency = 'High';
      else urgency = 'Medium';

      return {
        product: batch.stock.product,
        warehouse: batch.stock.warehouse.name,
        batchNumber: batch.batchNumber,
        quantity: batch.quantity,
        expiryDate: batch.expiryDate,
        daysUntilExpiry: daysUntilExp,
        urgency,
        value: batch.quantity * Number(batch.stock.product.unitPrice || 0),
      };
    });

    const totalValue = batches.reduce((sum, b) => sum + b.value, 0);

    return {
      batchCount: batches.length,
      totalQuantity: batches.reduce((sum, b) => sum + b.quantity, 0),
      totalValue,
      batches,
    };
  }

  async getWarehouseWiseStock(tenantId: string) {
    const warehouses = await this.prisma.warehouse.findMany({
      where: { tenantId, isActive: true },
      include: {
        stocks: {
          where: { quantity: { gt: 0 } },
          include: {
            product: {
              select: {
                unitPrice: true,
              },
            },
          },
        },
      },
    });

    return warehouses.map(warehouse => {
      const totalValue = warehouse.stocks.reduce(
        (sum, stock) => sum + stock.quantity * Number(stock.product.unitPrice || 0),
        0,
      );

      return {
        warehouse: {
          id: warehouse.id,
          name: warehouse.name,
          code: warehouse.code,
        },
        itemCount: warehouse.stocks.length,
        totalQuantity: warehouse.stocks.reduce((sum, s) => sum + s.quantity, 0),
        totalValue,
      };
    });
  }

  async getStockTurnoverRatio(tenantId: string, fromDate: Date, toDate: Date) {
    // COGS (Cost of Goods Sold)
    const soldItems = await this.prisma.salesOrderItem.aggregate({
      where: {
        salesOrder: {
          tenantId,
          orderDate: { gte: fromDate, lte: toDate },
          status: 'COMPLETED',
        },
      },
      _sum: {
        quantity: true,
        total: true,
      },
    });

    const cogs = Number(soldItems._sum.total || 0) * 0.7; // Rough 70% cost estimate

    // Average Inventory Value
    const inventoryValue = await this.calculateInventoryValue(tenantId);

    const turnoverRatio = inventoryValue > 0 ? cogs / inventoryValue : 0;
    const daysInPeriod = Math.floor(
      (toDate.getTime() - fromDate.getTime()) / (1000 * 60 * 60 * 24),
    );
    const daysSalesOfInventory = turnoverRatio > 0 ? daysInPeriod / turnoverRatio : 0;

    return {
      period: { from: fromDate, to: toDate },
      cogs,
      averageInventory: inventoryValue,
      turnoverRatio,
      daysSalesOfInventory: Math.round(daysSalesOfInventory),
    };
  }

  private async calculateInventoryValue(tenantId: string): Promise<number> {
    const stocks = await this.prisma.stock.findMany({
      where: {
        product: { tenantId },
      },
      select: {
        quantity: true,
        product: {
          select: {
            unitPrice: true,
          },
        },
      },
    });

    return stocks.reduce(
      (total, stock) => total + stock.quantity * Number(stock.product.unitPrice || 0),
      0,
    );
  }
}

