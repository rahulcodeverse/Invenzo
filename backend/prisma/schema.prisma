// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// TENANT & USER MANAGEMENT
// ============================================

model Tenant {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  address   String?
  gstNumber String?  @unique
  logo      String?
  settings  Json?    @default("{}")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users          User[]
  warehouses     Warehouse[]
  categories     Category[]
  brands         Brand[]
  units          Unit[]
  products       Product[]
  customers      Customer[]
  vendors        Vendor[]
  accountGroups  AccountGroup[]
  ledgerAccounts LedgerAccount[]
  companySettings CompanySettings?
  auditLogs      AuditLog[]
  notifications  Notification[]
  billOfMaterials BillOfMaterial[]
  workOrders      WorkOrder[]

  @@index([email])
  @@map("tenants")
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
  ACCOUNTANT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id                String     @id @default(uuid())
  tenantId          String
  email             String     @unique
  password          String
  firstName         String
  lastName          String
  phone             String?
  role              UserRole   @default(STAFF)
  status            UserStatus @default(ACTIVE)
  avatar            String?
  emailVerified     Boolean    @default(false)
  emailVerifiedAt   DateTime?
  resetToken        String?    @unique
  resetTokenExpiry  DateTime?
  refreshToken      String?
  lastLoginAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Relations
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditLogs         AuditLog[]
  purchaseOrders    PurchaseOrder[]
  salesOrders       SalesOrder[]
  stockMovements    StockMovement[]

  @@index([tenantId])
  @@index([email])
  @@map("users")
}

// ============================================
// WAREHOUSE MANAGEMENT
// ============================================

model Warehouse {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  code      String
  address   String?
  city      String?
  state     String?
  pincode   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stocks        Stock[]
  movements     StockMovement[]
  grns          GoodsReceivedNote[]
  deliveryNotes DeliveryNote[]
  workOrders    WorkOrder[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouses")
}

// ============================================
// PRODUCT CATALOG
// ============================================

model Category {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  description String?
  parentId    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  description String?
  logo        String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("brands")
}

model Unit {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  symbol    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("units")
}

model Product {
  id               String   @id @default(uuid())
  tenantId         String
  sku              String   @unique
  name             String
  description      String?
  categoryId       String
  brandId          String?
  unitId           String
  barcode          String?
  images           String[] @default([])
  costPrice        Decimal  @default(0) @db.Decimal(10, 2)
  sellingPrice     Decimal  @default(0) @db.Decimal(10, 2)
  mrp              Decimal? @db.Decimal(10, 2)
  taxRate          Decimal  @default(0) @db.Decimal(5, 2)
  minStockLevel    Int      @default(0)
  maxStockLevel    Int?
  reorderLevel     Int?
  hasVariants      Boolean  @default(false)
  hasBatch         Boolean  @default(false)
  hasSerial        Boolean  @default(false)
  trackExpiry      Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category        Category           @relation(fields: [categoryId], references: [id])
  brand           Brand?             @relation(fields: [brandId], references: [id])
  unit            Unit               @relation(fields: [unitId], references: [id])
  variants        ProductVariant[]
  stocks          Stock[]
  purchaseItems   PurchaseOrderItem[]
  salesItems      SalesOrderItem[]
  grnItems        GoodsReceivedItem[]
  finishedBoms    BillOfMaterial[] @relation("BomFinishedProduct")
  bomMaterials    BomItem[]        @relation("BomMaterial")
  workOrders      WorkOrder[]      @relation("WorkOrderProduct")
  workOrderMaterials WorkOrderMaterial[]

  @@index([tenantId])
  @@index([sku])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  sku       String   @unique
  name      String
  options   Json     @default("{}")
  costPrice Decimal  @default(0) @db.Decimal(10, 2)
  sellingPrice Decimal @default(0) @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

// ============================================
// INVENTORY MANAGEMENT
// ============================================

model Stock {
  id          String   @id @default(uuid())
  productId   String
  warehouseId String
  quantity    Int      @default(0)
  reserved    Int      @default(0)
  available   Int      @default(0)
  updatedAt   DateTime @updatedAt

  // Relations
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  batches   Batch[]
  serials   Serial[]

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
  @@map("stocks")
}

model Batch {
  id            String    @id @default(uuid())
  stockId       String
  batchNumber   String    @unique
  quantity      Int       @default(0)
  manufactureDate DateTime?
  expiryDate    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId])
  @@index([expiryDate])
  @@map("batches")
}

model Serial {
  id           String   @id @default(uuid())
  stockId      String
  serialNumber String   @unique
  isAvailable  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId])
  @@map("serials")
}

enum MovementType {
  IN
  OUT
  TRANSFER
  RETURN
  DAMAGE
  ADJUSTMENT
}

model StockMovement {
  id              String       @id @default(uuid())
  warehouseId     String
  productId       String
  type            MovementType
  quantity        Int
  fromWarehouseId String?
  toWarehouseId   String?
  reference       String?
  referenceId     String?
  notes           String?
  createdBy       String
  createdAt       DateTime     @default(now())

  // Relations
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  user      User      @relation(fields: [createdBy], references: [id])

  @@index([warehouseId])
  @@index([productId])
  @@index([createdAt])
  @@map("stock_movements")
}

// ============================================
// MANUFACTURING & PRODUCTION
// ============================================

enum WorkOrderStatus {
  PLANNED
  RELEASED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model BillOfMaterial {
  id          String   @id @default(uuid())
  tenantId    String
  bomNumber   String   @unique
  productId   String
  name        String
  version     String   @default("1.0")
  outputQty   Decimal  @default(1) @db.Decimal(10, 2)
  notes       String?
  isActive    Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product      Product       @relation("BomFinishedProduct", fields: [productId], references: [id])
  items        BomItem[]
  routingSteps RoutingStep[]
  workOrders   WorkOrder[]

  @@index([tenantId])
  @@index([productId])
  @@index([bomNumber])
  @@map("bill_of_materials")
}

model BomItem {
  id             String   @id @default(uuid())
  bomId          String
  materialId     String
  quantity       Decimal  @db.Decimal(10, 3)
  wastagePercent Decimal  @default(0) @db.Decimal(5, 2)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bom      BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)
  material Product        @relation("BomMaterial", fields: [materialId], references: [id])

  @@index([bomId])
  @@index([materialId])
  @@map("bom_items")
}

model RoutingStep {
  id               String   @id @default(uuid())
  bomId            String
  sequence         Int
  processName      String
  workCenter       String?
  estimatedMinutes Int?
  instructions     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bom BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@index([bomId])
  @@map("routing_steps")
}

model WorkOrder {
  id              String          @id @default(uuid())
  tenantId        String
  workOrderNumber String          @unique
  bomId           String
  productId       String
  warehouseId     String
  salesOrderId    String?
  plannedQty      Decimal         @db.Decimal(10, 2)
  producedQty     Decimal         @default(0) @db.Decimal(10, 2)
  rejectedQty     Decimal         @default(0) @db.Decimal(10, 2)
  status          WorkOrderStatus @default(PLANNED)
  plannedStart    DateTime?
  dueDate         DateTime?
  completedAt     DateTime?
  notes           String?
  createdBy       String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bom       BillOfMaterial      @relation(fields: [bomId], references: [id])
  product   Product             @relation("WorkOrderProduct", fields: [productId], references: [id])
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  materials WorkOrderMaterial[]

  @@index([tenantId])
  @@index([workOrderNumber])
  @@index([bomId])
  @@index([productId])
  @@index([warehouseId])
  @@index([status])
  @@map("work_orders")
}

model WorkOrderMaterial {
  id          String   @id @default(uuid())
  workOrderId String
  productId   String
  plannedQty  Decimal  @db.Decimal(10, 3)
  issuedQty   Decimal  @default(0) @db.Decimal(10, 3)
  consumedQty Decimal  @default(0) @db.Decimal(10, 3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([workOrderId])
  @@index([productId])
  @@map("work_order_materials")
}

// ============================================
// VENDOR & PURCHASE MANAGEMENT
// ============================================

model Vendor {
  id            String   @id @default(uuid())
  tenantId      String
  code          String
  name          String
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  gstNumber     String?
  creditLimit   Decimal  @default(0) @db.Decimal(10, 2)
  creditDays    Int      @default(0)
  openingBalance Decimal @default(0) @db.Decimal(10, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("vendors")
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

model PurchaseOrder {
  id            String        @id @default(uuid())
  tenantId      String
  poNumber      String        @unique
  vendorId      String
  orderDate     DateTime      @default(now())
  expectedDate  DateTime?
  status        OrderStatus   @default(DRAFT)
  paymentStatus PaymentStatus @default(PENDING)
  subtotal      Decimal       @default(0) @db.Decimal(10, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @default(0) @db.Decimal(10, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(10, 2)
  notes         String?
  createdBy     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  vendor Vendor              @relation(fields: [vendorId], references: [id])
  user   User                @relation(fields: [createdBy], references: [id])
  items  PurchaseOrderItem[]
  grns   GoodsReceivedNote[]

  @@index([tenantId])
  @@index([poNumber])
  @@index([vendorId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  receivedQty     Int      @default(0)
  unitPrice       Decimal  @db.Decimal(10, 2)
  taxRate         Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(10, 2)
  total           Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model GoodsReceivedNote {
  id              String   @id @default(uuid())
  grnNumber       String   @unique
  purchaseOrderId String
  warehouseId     String
  receivedDate    DateTime @default(now())
  receivedBy      String
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  purchaseOrder PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id])
  warehouse     Warehouse           @relation(fields: [warehouseId], references: [id])
  items         GoodsReceivedItem[]
  invoices      PurchaseInvoice[]

  @@index([purchaseOrderId])
  @@index([warehouseId])
  @@map("goods_received_notes")
}

model GoodsReceivedItem {
  id        String   @id @default(uuid())
  grnId     String
  productId String
  quantity  Int
  batchNumber String?
  expiryDate  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  grn     GoodsReceivedNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  product Product           @relation(fields: [productId], references: [id])

  @@index([grnId])
  @@index([productId])
  @@map("goods_received_items")
}

model PurchaseInvoice {
  id              String        @id @default(uuid())
  tenantId        String
  invoiceNumber   String        @unique
  purchaseOrderId String
  grnId           String?
  vendorId        String
  invoiceDate     DateTime      @default(now())
  dueDate         DateTime
  status          PaymentStatus @default(PENDING)
  subtotal        Decimal       @default(0) @db.Decimal(10, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(10, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
  total           Decimal       @default(0) @db.Decimal(10, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(10, 2)
  balanceAmount   Decimal       @default(0) @db.Decimal(10, 2)
  notes           String?
  createdBy       String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  grn      GoodsReceivedNote? @relation(fields: [grnId], references: [id])
  payments VendorPayment[]

  @@index([tenantId])
  @@index([invoiceNumber])
  @@index([purchaseOrderId])
  @@map("purchase_invoices")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CREDIT_CARD
  UPI
  OTHER
}

model VendorPayment {
  id          String        @id @default(uuid())
  tenantId    String
  vendorId    String
  invoiceId   String?
  paymentNumber String      @unique
  paymentDate DateTime      @default(now())
  amount      Decimal       @db.Decimal(10, 2)
  method      PaymentMethod @default(BANK_TRANSFER)
  reference   String?
  notes       String?
  createdBy   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  invoice PurchaseInvoice? @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([vendorId])
  @@index([paymentNumber])
  @@map("vendor_payments")
}

// ============================================
// CUSTOMER & SALES MANAGEMENT
// ============================================

model Customer {
  id             String   @id @default(uuid())
  tenantId       String
  code           String
  name           String
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  pincode        String?
  gstNumber      String?
  creditLimit    Decimal  @default(0) @db.Decimal(10, 2)
  creditDays     Int      @default(0)
  openingBalance Decimal  @default(0) @db.Decimal(10, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotations  Quotation[]
  salesOrders SalesOrder[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("customers")
}

model Quotation {
  id              String      @id @default(uuid())
  tenantId        String
  quotationNumber String      @unique
  customerId      String
  quotationDate   DateTime    @default(now())
  validUntil      DateTime
  status          OrderStatus @default(DRAFT)
  subtotal        Decimal     @default(0) @db.Decimal(10, 2)
  taxAmount       Decimal     @default(0) @db.Decimal(10, 2)
  discount        Decimal     @default(0) @db.Decimal(10, 2)
  total           Decimal     @default(0) @db.Decimal(10, 2)
  notes           String?
  termsConditions String?
  convertedToSO   Boolean     @default(false)
  salesOrderId    String?
  createdBy       String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  customer Customer         @relation(fields: [customerId], references: [id])
  items    QuotationItem[]

  @@index([tenantId])
  @@index([quotationNumber])
  @@index([customerId])
  @@map("quotations")
}

model QuotationItem {
  id           String   @id @default(uuid())
  quotationId  String
  productId    String
  quantity     Int
  unitPrice    Decimal  @db.Decimal(10, 2)
  taxRate      Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount    Decimal  @default(0) @db.Decimal(10, 2)
  discount     Decimal  @default(0) @db.Decimal(10, 2)
  total        Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

model SalesOrder {
  id            String        @id @default(uuid())
  tenantId      String
  soNumber      String        @unique
  customerId    String
  quotationId   String?
  orderDate     DateTime      @default(now())
  deliveryDate  DateTime?
  status        OrderStatus   @default(DRAFT)
  paymentStatus PaymentStatus @default(PENDING)
  subtotal      Decimal       @default(0) @db.Decimal(10, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @default(0) @db.Decimal(10, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(10, 2)
  notes         String?
  createdBy     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  customer      Customer        @relation(fields: [customerId], references: [id])
  user          User            @relation(fields: [createdBy], references: [id])
  items         SalesOrderItem[]
  deliveryNotes DeliveryNote[]
  invoices      SalesInvoice[]

  @@index([tenantId])
  @@index([soNumber])
  @@index([customerId])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String   @id @default(uuid())
  salesOrderId String
  productId    String
  quantity     Int
  deliveredQty Int      @default(0)
  unitPrice    Decimal  @db.Decimal(10, 2)
  taxRate      Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount    Decimal  @default(0) @db.Decimal(10, 2)
  discount     Decimal  @default(0) @db.Decimal(10, 2)
  total        Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@index([salesOrderId])
  @@map("sales_order_items")
}

model DeliveryNote {
  id            String   @id @default(uuid())
  deliveryNumber String  @unique
  salesOrderId  String
  warehouseId   String
  deliveryDate  DateTime @default(now())
  deliveredBy   String
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  salesOrder SalesOrder      @relation(fields: [salesOrderId], references: [id])
  warehouse  Warehouse       @relation(fields: [warehouseId], references: [id])
  items      DeliveryItem[]
  invoices   SalesInvoice[]

  @@index([salesOrderId])
  @@index([warehouseId])
  @@map("delivery_notes")
}

model DeliveryItem {
  id             String   @id @default(uuid())
  deliveryNoteId String
  productId      String
  quantity       Int
  batchNumber    String?
  serialNumbers  String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  deliveryNote DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)

  @@index([deliveryNoteId])
  @@map("delivery_items")
}

model SalesInvoice {
  id              String        @id @default(uuid())
  tenantId        String
  invoiceNumber   String        @unique
  salesOrderId    String
  deliveryNoteId  String?
  customerId      String
  invoiceDate     DateTime      @default(now())
  dueDate         DateTime
  status          PaymentStatus @default(PENDING)
  subtotal        Decimal       @default(0) @db.Decimal(10, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(10, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
  total           Decimal       @default(0) @db.Decimal(10, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(10, 2)
  balanceAmount   Decimal       @default(0) @db.Decimal(10, 2)
  notes           String?
  createdBy       String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  salesOrder   SalesOrder        @relation(fields: [salesOrderId], references: [id])
  deliveryNote DeliveryNote?     @relation(fields: [deliveryNoteId], references: [id])
  payments     CustomerPayment[]

  @@index([tenantId])
  @@index([invoiceNumber])
  @@index([salesOrderId])
  @@index([customerId])
  @@map("sales_invoices")
}

model CustomerPayment {
  id            String        @id @default(uuid())
  tenantId      String
  customerId    String
  invoiceId     String?
  paymentNumber String        @unique
  paymentDate   DateTime      @default(now())
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod @default(BANK_TRANSFER)
  reference     String?
  notes         String?
  createdBy     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  invoice SalesInvoice? @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([customerId])
  @@index([paymentNumber])
  @@map("customer_payments")
}

// ============================================
// ACCOUNTING & FINANCE
// ============================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum AccountSubType {
  CURRENT_ASSET
  FIXED_ASSET
  CURRENT_LIABILITY
  LONG_TERM_LIABILITY
  OWNERS_EQUITY
  RETAINED_EARNINGS
  SALES_REVENUE
  OTHER_INCOME
  COST_OF_GOODS_SOLD
  OPERATING_EXPENSE
  OTHER_EXPENSE
}

model AccountGroup {
  id          String         @id @default(uuid())
  tenantId    String
  name        String
  code        String
  type        AccountType
  subType     AccountSubType?
  parentId    String?
  description String?
  isSystem    Boolean        @default(false)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   AccountGroup?  @relation("GroupHierarchy", fields: [parentId], references: [id])
  children AccountGroup[] @relation("GroupHierarchy")
  accounts LedgerAccount[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([type])
  @@map("account_groups")
}

model LedgerAccount {
  id              String         @id @default(uuid())
  tenantId        String
  groupId         String
  name            String
  code            String
  type            AccountType
  subType         AccountSubType?
  description     String?
  openingBalance  Decimal        @default(0) @db.Decimal(12, 2)
  currentBalance  Decimal        @default(0) @db.Decimal(12, 2)
  isSystem        Boolean        @default(false)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group         AccountGroup    @relation(fields: [groupId], references: [id])
  journalLines  JournalLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([groupId])
  @@index([type])
  @@map("ledger_accounts")
}

enum JournalType {
  MANUAL
  PURCHASE_INVOICE
  PURCHASE_PAYMENT
  SALES_INVOICE
  SALES_PAYMENT
  STOCK_ADJUSTMENT
  OPENING_BALANCE
  CLOSING
  REVERSAL
}

model JournalEntry {
  id            String      @id @default(uuid())
  tenantId      String
  journalNumber String      @unique
  type          JournalType
  date          DateTime    @default(now())
  reference     String?
  referenceId   String?
  narration     String
  totalDebit    Decimal     @default(0) @db.Decimal(12, 2)
  totalCredit   Decimal     @default(0) @db.Decimal(12, 2)
  isReversed    Boolean     @default(false)
  reversalId    String?
  createdBy     String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  lines JournalLine[]

  @@index([tenantId])
  @@index([journalNumber])
  @@index([type])
  @@index([date])
  @@index([reference])
  @@map("journal_entries")
}

enum LineType {
  DEBIT
  CREDIT
}

model JournalLine {
  id        String   @id @default(uuid())
  journalId String
  accountId String
  type      LineType
  amount    Decimal  @db.Decimal(12, 2)
  narration String?
  createdAt DateTime @default(now())

  // Relations
  journal JournalEntry   @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account LedgerAccount  @relation(fields: [accountId], references: [id])

  @@index([journalId])
  @@index([accountId])
  @@map("journal_lines")
}

// ============================================
// NOTIFICATIONS & AUDIT
// ============================================

enum NotificationType {
  LOW_STOCK
  EXPIRY_ALERT
  PAYMENT_REMINDER
  ORDER_UPDATE
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid())
  tenantId  String
  userId    String?
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String
  action     String
  entity     String
  entityId   String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// COMPANY SETTINGS
// ============================================

model CompanySettings {
  id         String   @id @default(uuid())
  tenantId   String   @unique
  name       String
  email      String
  phone      String
  website    String?
  address    String
  city       String
  state      String
  country    String
  postalCode String
  taxId      String?
  currency   String   @default("USD")
  logo       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("company_settings")
}
